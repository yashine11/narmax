PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-frontend-site.vercel.app

# Turso Cloud Database (Get these from https://turso.tech)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Auth & Security
JWT_SECRET=your-secure-jwt-secret-min-32-chars-long
JWT_EXPIRES=7d

# TMDB API
TMDB_API_KEY=896737db9409886ed7e5a2f32e69745e

# Admin Defaults (Seeded on first launch)
ADMIN_EMAIL=admin@narmax.local
ADMIN_PASSWORD=YourStrongAdminPassword123!
ADMIN_USERNAME=admin

KIDS_DEFAULT_CODE=1234
